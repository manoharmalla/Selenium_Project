<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="retry.retryTransfer"/>
    </listeners>

    <test name="Launch Application Test">

        <classes>

            <class name="tests.LaunchApplication"/>
        </classes>

    </test>
    <test name="verify cart page">

        <classes>

            <class name="tests.CartTest"/>
        </classes>

    </test>
    <test name="verify login page">

        <classes>

            <class name="tests.LoginTest"/>
        </classes>

    </test>
    <test name="verify Nikon camera product">
        <classes>
            <class name="tests.CameraProductTest"/>
        </classes>
    </test>
    <test name="verify IZI gimbal product">
        <classes>
            <class name="tests.IziGimbalTest"/>
        </classes>
    </test>
</suite>